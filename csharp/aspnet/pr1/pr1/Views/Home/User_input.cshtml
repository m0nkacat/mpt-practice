@{
    ViewData["Title"] = ViewBag.Title ?? "Ввод данных";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>


    <form method="post">
        <div class="form-row">

            <div class="form-group col-md-3">
                <label>Номер карточки:</label>
                <input type="text" class="form-control form-control-sm" name="word1" />
            </div>
            <div class="form-group col-md-3">
                <label>Срок действия:</label>
                <input type="text" class="form-control form-control-sm" name="word2" />
            </div>
            <div class="form-group col-md-3">
                <label>CVV код:</label>
                <input type="text" class="form-control form-control-sm" name="word3" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">купить голду в стендофе</button>
    </form>
    

    
</div>