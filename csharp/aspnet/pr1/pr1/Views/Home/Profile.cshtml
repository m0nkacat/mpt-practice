@{
    ViewData["Title"] = "Твоя карточка";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

        <div class="mt-4 p-3 border rounded">
            <h2>Инфа о тебе:</h2>
            <div class="row">
                <div class="col-md-4">
                    <strong>Сколько денег у тебя будет:</strong><br />
                    @ViewBag.CardNumber 
                </div>
                <div class="col-md-4">
                    <strong>Когда будет первый миллион$$:</strong><br />
                    @ViewBag.ExpiryDate
                </div>
                <div class="col-md-4">
                    <strong>Сколько лет будешь счастлив:</strong><br />
                    @ViewBag.CVV 
                </div>
            </div>
            
        </div>


</div>