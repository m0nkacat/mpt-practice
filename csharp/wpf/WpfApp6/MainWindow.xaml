<Window x:Class="Wpf6App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информационный вывод" Height="450" Width="500"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Width" Value="150"/>
        </Style>
    </Window.Resources>

    <DockPanel>
 
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Выход" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Параметры">
                <MenuItem Header="_Цвет" Click="ChangeColor_Click" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Тип рамки" Click="ChangeBorder_Click" InputGestureText="Ctrl+B"/>
                <MenuItem Header="_Толщина" Click="ChangeThickness_Click" InputGestureText="Ctrl+T"/>
                <Separator/>
                <MenuItem Header="_Сбросить" Click="Reset_Click" InputGestureText="Ctrl+R"/>
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>


        <Border x:Name="FigureBorder" Background="LightGray" Margin="10" 
                ContextMenuOpening="FigureBorder_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Изменить цвет" Click="ChangeColor_Click"/>
                    <MenuItem Header="Изменить тип рамки" Click="ChangeBorder_Click"/>
                    <MenuItem Header="Изменить толщину" Click="ChangeThickness_Click"/>
                    <Separator/>
                    <MenuItem Header="Сбросить" Click="Reset_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Rectangle x:Name="Figure" Width="200" Height="150" 
                       Fill="DodgerBlue" Stroke="Black" StrokeThickness="2"/>
        </Border>

    
        <StackPanel DockPanel.Dock="Bottom" Margin="10" Background="Beige">
            <TextBlock x:Name="StateText" TextWrapping="Wrap" 
                       FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
        </StackPanel>
    </DockPanel>
</Window>