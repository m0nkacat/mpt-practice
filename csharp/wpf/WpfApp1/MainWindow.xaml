<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="pickme_button" Content="Пикми кнопка" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Height="40" Width="274" Click="Button_Click" Background="#FFFD29CE" BorderBrush="#FF8421DA" Foreground="#FFFD0F0F" FontSize="16">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.175"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="pickme_button_2" Content="Пикми кнопка №2" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="40" Width="274" Click="Button_Click" Background="#FFFD29CE" BorderBrush="#FF8421DA" Foreground="#FFFD0F0F" FontSize="16" Margin="0,270,0,0">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.175"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="button" Content="Впадлу думать над&#xD;&#xA;названием&#xD;&#xA;67" HorizontalAlignment="Center" Margin="0,98,0,0" VerticalAlignment="Top" Height="82" Width="140" Click="Button_Click_1"/>
    </Grid>
</Window>
